# Environment variables template for SIPS Voice Assistant

# Firebase RTDB (READ/WRITE for sensors and actuators)
FIREBASE_URL=https://linoplantsys-default-rtdb.asia-southeast1.firebasedatabase.app

# Gemini API Keys (2-3 akun, rotasi otomatis kalau limit)
# Dapatkan dari: https://aistudio.google.com/app/apikey
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# Gemini model (terbaru & cepat)
GEMINI_MODEL=gemini-2.5-flash

# Voice Edge-TTS (cewek santai Indonesia)
TTS_VOICE=id-ID-GadisNeural
TTS_RATE=+5%
TTS_PITCH=+0Hz
